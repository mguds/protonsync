+func selectSharedWithMeRoot(ctx context.Context, f *Fs, protonDrive *protonDriveAPI.ProtonDrive, root string) (string, error) {
+	if root == "" {
+		return "", fmt.Errorf("shared_with_me requires a path starting with a shared item name")
+	}
+
+	sharedRootName, remainingRoot, _ := strings.Cut(root, "/")
+	sharedItems, err := protonDrive.ListSharedWithMe(ctx)
+	if err != nil {
+		return "", err
+	}
+
+	for _, item := range sharedItems {
+		if f.opt.Enc.ToStandardName(item.Name) != sharedRootName {
+			continue
+		}
+		if !item.IsFolder && remainingRoot != "" {
+			return "", fmt.Errorf("shared item %q is not a folder", sharedRootName)
+		}
+		if err := protonDrive.SwitchToShare(ctx, item.ShareID, item.LinkID); err != nil {
+			return "", err
+		}
+		fs.Debugf(f, "Selected shared-with-me item %q (share %s, link %s)", item.Name, item.ShareID, item.LinkID)
+		return remainingRoot, nil
+	}
+
+	return "", fs.ErrorDirNotFound
+}
