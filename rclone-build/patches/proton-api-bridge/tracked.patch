 )
 
+type SharedWithMeItem struct {
+	VolumeID string
+	ShareID  string
+	LinkID   string
+	Name     string
+	IsFolder bool
+	Link     *proton.Link
+}
+
 func getAllShares(ctx context.Context, c *proton.Client) ([]proton.ShareMetadata, error) {
 	shares, err := c.ListShares(ctx, true)
 	if err != nil {
@@ -23,3 +34,165 @@ func getShareByID(ctx context.Context, c *proton.Client, shareID string) (*proto
 
 	return &share, nil
 }
+
+func isSupportedSharedWithMeTarget(target *proton.ShareTargetType) bool {
+	if target == nil {
+		return true
+	}
+
+	return *target == proton.ShareTargetTypeFolder ||
+		*target == proton.ShareTargetTypeFile ||
+		*target == proton.ShareTargetTypeProtonVendor
+}
+
+func (protonDrive *ProtonDrive) getShareKR(ctx context.Context, share *proton.Share) (*crypto.KeyRing, error) {
+	addrKR := protonDrive.DefaultAddrKR
+	if share.AddressID != "" {
+		if kr, ok := protonDrive.addrKRs[share.AddressID]; ok {
+			addrKR = kr
+		}
+	}
+	signatureVerificationKR, err := protonDrive.getSignatureVerificationKeyring(ctx, []string{share.Creator}, addrKR)
+	if err != nil {
+		return nil, err
+	}
+	return share.GetKeyRing(addrKR, signatureVerificationKR)
+}
+
+func (protonDrive *ProtonDrive) isShareRootLink(link *proton.Link) bool {
+	if link == nil {
+		return false
+	}
+	if link.LinkID == protonDrive.RootLink.LinkID || link.LinkID == protonDrive.MainShare.LinkID || link.ParentLinkID == "" {
+		return true
+	}
+	return false
+}
+
+func (protonDrive *ProtonDrive) sharedLinkParentKR(ctx context.Context, share *proton.Share, link *proton.Link, shareKR *crypto.KeyRing) (*crypto.KeyRing, error) {
+	if link.LinkID == share.LinkID || link.ParentLinkID == "" {
+		return shareKR, nil
+	}
+
+	parentLink, err := protonDrive.c.GetLink(ctx, share.ShareID, link.ParentLinkID)
+	if err != nil {
+		return nil, fmt.Errorf("get shared parent link %s in share %s: %w", link.ParentLinkID, share.ShareID, err)
+	}
+
+	parentKR, err := protonDrive.sharedLinkParentKR(ctx, share, &parentLink, shareKR)
+	if err != nil {
+		return nil, fmt.Errorf("get shared parent keyring for link %s in share %s: %w", parentLink.LinkID, share.ShareID, err)
+	}
+
+	signatureVerificationKR, err := protonDrive.getSignatureVerificationKeyring(ctx, []string{parentLink.SignatureEmail}, parentKR)
+	if err != nil {
+		return nil, fmt.Errorf("get shared parent signature keyring for link %s signature email %q: %w", parentLink.LinkID, parentLink.SignatureEmail, err)
+	}
+	parentLinkKR, err := parentLink.GetKeyRing(parentKR, signatureVerificationKR)
+	if err != nil {
+		return nil, fmt.Errorf("decrypt shared parent link keyring for link %s signature email %q: %w", parentLink.LinkID, parentLink.SignatureEmail, err)
+	}
+	return parentLinkKR, nil
+}
+
+func (protonDrive *ProtonDrive) sharedLinkName(ctx context.Context, share *proton.Share, link *proton.Link, shareKR *crypto.KeyRing) (string, error) {
+	parentKR, err := protonDrive.sharedLinkParentKR(ctx, share, link, shareKR)
+	if err != nil {
+		return "", fmt.Errorf("get shared link parent keyring for link %s in share %s: %w", link.LinkID, share.ShareID, err)
+	}
+
+	signatureVerificationKR, err := protonDrive.getSignatureVerificationKeyring(ctx, []string{link.NameSignatureEmail, link.SignatureEmail}, parentKR)
+	if err != nil {
+		return "", fmt.Errorf("get shared link name signature keyring for link %s name email %q signature email %q: %w", link.LinkID, link.NameSignatureEmail, link.SignatureEmail, err)
+	}
+	name, err := link.GetName(parentKR, signatureVerificationKR)
+	if err != nil {
+		return "", fmt.Errorf("decrypt shared link name for link %s name email %q signature email %q: %w", link.LinkID, link.NameSignatureEmail, link.SignatureEmail, err)
+	}
+	return name, nil
+}
+
+func (protonDrive *ProtonDrive) ListSharedWithMe(ctx context.Context) ([]*SharedWithMeItem, error) {
+	var ret []*SharedWithMeItem
+	anchorID := ""
+
+	for {
+		links, nextAnchorID, more, err := protonDrive.c.ListSharedWithMe(ctx, anchorID)
+		if err != nil {
+			return nil, err
+		}
+
+		for i := range links {
+			if !isSupportedSharedWithMeTarget(links[i].ShareTargetType) {
+				continue
+			}
+
+			share, err := getShareByID(ctx, protonDrive.c, links[i].ShareID)
+			if err != nil {
+				return nil, fmt.Errorf("get shared-with-me share %s: %w", links[i].ShareID, err)
+			}
+
+			link, err := protonDrive.c.GetLink(ctx, links[i].ShareID, links[i].LinkID)
+			if err != nil {
+				return nil, fmt.Errorf("get shared-with-me link %s in share %s: %w", links[i].LinkID, links[i].ShareID, err)
+			}
+
+			shareKR, err := protonDrive.getShareKR(ctx, share)
+			if err != nil {
+				return nil, fmt.Errorf("decrypt shared-with-me share keyring %s: %w", links[i].ShareID, err)
+			}
+
+			name, err := protonDrive.sharedLinkName(ctx, share, &link, shareKR)
+			if err != nil {
+				return nil, fmt.Errorf("decrypt shared-with-me item name link %s share %s: %w", links[i].LinkID, links[i].ShareID, err)
+			}
+
+			ret = append(ret, &SharedWithMeItem{
+				VolumeID: links[i].VolumeID,
+				ShareID:  links[i].ShareID,
+				LinkID:   links[i].LinkID,
+				Name:     name,
+				IsFolder: link.Type == proton.LinkTypeFolder,
+				Link:     &link,
+			})
+		}
+
+		if !more || nextAnchorID == "" {
+			break
+		}
+		anchorID = nextAnchorID
+	}
+
+	return ret, nil
+}
+
+func (protonDrive *ProtonDrive) SwitchToShare(ctx context.Context, shareID, linkID string) error {
+	share, err := getShareByID(ctx, protonDrive.c, shareID)
+	if err != nil {
+		return err
+	}
+
+	rootLink, err := protonDrive.c.GetLink(ctx, share.ShareID, linkID)
+	if err != nil {
+		return err
+	}
+
+	shareKR, err := protonDrive.getShareKR(ctx, share)
+	if err != nil {
+		return err
+	}
+
+	protonDrive.MainShare = share
+	protonDrive.RootLink = &rootLink
+	protonDrive.MainShareKR = shareKR
+	if share.AddressID != "" {
+		if kr, ok := protonDrive.addrKRs[share.AddressID]; ok {
+			protonDrive.DefaultAddrKR = kr
+		}
+	}
+	// Keep the authenticated user's active address for new signatures.
+	// share.Creator belongs to the owner and is only valid for verification.
+	protonDrive.cache = newCache(protonDrive.Config.EnableCaching, protonDrive.Config.GetLogger())
+
+	return nil
+}
